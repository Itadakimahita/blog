# Local development environment template (no real secrets).
BLOG_ENV_ID=local

# Redis / Celery / Flower
BLOG_REDIS_URL=redis://redis:6379/0
BLOG_CELERY_BROKER_URL=redis://redis:6379/1
BLOG_FLOWER_USER=admin
BLOG_FLOWER_PASSWORD=changeme

# Optional
BLOG_SEED_DB=false
BLOG_SQLITE_PATH=/data/db.sqlite3

