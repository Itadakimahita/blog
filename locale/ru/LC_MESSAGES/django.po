msgid "Email field is required."
msgstr "Поле Email обязательно."

msgid "Full name field is required."
msgstr "Поле полного имени обязательно."

msgid "Unsupported language. Supported: en, ru, kk."
msgstr "Неподдерживаемый язык. Доступно: en, ru, kk."

msgid "Timezone is required."
msgstr "Часовой пояс обязателен."

msgid "Invalid timezone. Use a valid IANA identifier (e.g. 'UTC' or 'Asia/Almaty')."
msgstr "Некорректный часовой пояс. Используйте корректный идентификатор IANA (например, «UTC» или «Asia/Almaty»)."

msgid "No users found."
msgstr "Пользователи не найдены."

msgid "Preferred language updated."
msgstr "Предпочитаемый язык обновлён."

msgid "Timezone updated."
msgstr "Часовой пояс обновлён."

msgid "No posts found."
msgstr "Публикации не найдены."

msgid "Post not found."
msgstr "Публикация не найдена."

msgid "No comments found for this post."
msgstr "Для этой публикации комментарии не найдены."

msgid "Too many requests. Try again later."
msgstr "Слишком много запросов. Попробуйте позже."

msgid "Welcome to Advanced Blog"
msgstr "Добро пожаловать в Advanced Blog"

msgid "Hi %(first_name)s,"
msgstr "Здравствуйте, %(first_name)s,"

msgid "Thanks for registering at Advanced Blog."
msgstr "Спасибо за регистрацию в Advanced Blog."

msgid "You can now sign in and start reading posts in your language."
msgstr "Теперь вы можете войти и читать публикации на своём языке."

msgid "If you did not create this account, you can ignore this email."
msgstr "Если вы не создавали этот аккаунт, просто проигнорируйте это письмо."

msgid "— The Advanced Blog team"
msgstr "— Команда Advanced Blog"

